POSTGRES_USER=smartai
POSTGRES_PASSWORD=smartai_secret_2024
POSTGRES_DB=smartai_tutor
POSTGRES_HOST=db
POSTGRES_PORT=5432

# DEBUG=true → EXTREME step-by-step lesson logging (each agent's task + final answer, every tool
# call + result, RAG chunks, deck-map slide moves). false → normal concise logs.
DEBUG=false

RESOURCEHUB_API_KEY=
RESOURCEHUB_API_URL=https://hub.resourcefullearning.co.uk/api
# Background sync of curriculum + resources from the Resource Hub
RESOURCE_SYNC_ENABLED=true
CURRICULUM_SYNC_HOURS=12
RESOURCE_SYNC_HOURS=6
# Delay before the FIRST sync after boot — leaves a window to run `python -m app.setup --fresh`
# (which drops/recreates the schema) before a sync grabs table locks.
RESOURCE_SYNC_START_DELAY_MINUTES=1

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Per-pipeline models: in-lesson SESSION (all lesson agents + quiz/eval) vs free /chat.
GEMINI_SESSION_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Thinking tokens generated BEFORE each answer — higher = slower but more reasoning. 0 = off.
GEMINI_THINKING_BUDGET=512
# Native image generation for puzzle/explanatory images — image model.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

JWT_SECRET_KEY=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ── Auth: Google OAuth + email verification ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Backend base URL for the OAuth redirect_uri (callback = <this>/api/auth/oauth/google/callback)
OAUTH_REDIRECT_BASE_URL=http://localhost:8001
# Secret for the OAuth session cookie (defaults to JWT_SECRET_KEY if blank)
SESSION_SECRET=
# Frontend base URL used in verification email links + OAuth success redirect
FRONTEND_BASE_URL=http://localhost:3000

# Email (verification links). Set EMAIL_ENABLED=true + SMTP creds in production.
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@smartai.com

BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# ── RAG (pgvector retrieval over Resource Hub content) ──
EMBEDDING_MODEL=gemini-embedding-001
RAG_ENABLED=true
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.3
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ── Storage (paths served back to the browser) ──
UPLOAD_DIR=uploads/documents
PUZZLE_MEDIA_DIR=uploads/gen_puzzles
MAX_UPLOAD_SIZE_MB=50

# ── Platform limits ──
MAX_APPOINTMENTS_PER_WEEK=100
